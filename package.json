{
  "name": "quantdesk",
  "productName": "QuantDesk",
  "version": "1.1.0",
  "description": "QuantDesk - 美股量化终端 (US Equity Quant Terminal) v1.1.0",
  "main": "src/main/main.js",
  "author": "hejialiang",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "smoke": "node scripts/smoke.js",
    "ui-smoke": "bash scripts/ui-smoke.sh",
    "shots": "bash scripts/shots.sh",
    "radar": "node scripts/radar-cli.js",
    "report": "node scripts/radar-report.js",
    "verify": "node scripts/verify-quotes.js",
    "dist": "bash scripts/build-dmg.sh",
    "dist:builder": "electron-builder --mac --arm64 --publish never",
    "pack": "electron-builder --dir --mac --arm64",
    "icon": "node scripts/make-icon.js",
    "install:local": "bash scripts/install-local.sh"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.quantdesk.terminal",
    "productName": "QuantDesk",
    "copyright": "Copyright © 2026 QuantDesk",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "build"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.finance",
      "icon": "assets/icon.icns",
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "identity": null,
      "extendInfo": {
        "NSHighResolutionCapable": true
      }
    },
    "dmg": {
      "title": "QuantDesk 美股量化终端",
      "sign": false,
      "window": {
        "width": 700,
        "height": 440
      },
      "contents": [
        {
          "x": 180,
          "y": 210,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 520,
          "y": 210,
          "type": "file"
        }
      ]
    }
  }
}
